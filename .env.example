# ---------------------------------------------------------------------------
# nest-apps — local development environment
# Copy to `.env` (git-ignored) and change the values. Never commit `.env`.
# Used by docker-compose.yml (PostgreSQL) and by apps/api (FastAPI settings).
# ---------------------------------------------------------------------------

# --- PostgreSQL container (docker-compose.yml) ---
POSTGRES_USER=nest
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=nest
# 5433 on the host: a native Windows PostgreSQL may already use 5432
POSTGRES_PORT=5433

# --- FastAPI (apps/api) ---
APP_ENV=development
# async SQLAlchemy URL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://nest:change-me-local-only@localhost:5433/nest
# separate database used by pytest (created by infrastructure/postgres/init)
TEST_DATABASE_URL=postgresql+asyncpg://nest:change-me-local-only@localhost:5433/nest_test
# comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3001
LOG_LEVEL=INFO

# --- Auth (ARCHITECTURE §7) ---
# signs access tokens; at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-long-random-value
