# ---------------------------------------------------------------------------
# nest-apps — local development environment
# Copy to `.env` (git-ignored) and change the values. Never commit `.env`.
# Used by docker-compose.yml (PostgreSQL) and by apps/api (FastAPI settings).
# ---------------------------------------------------------------------------

# --- PostgreSQL container (docker-compose.yml) ---
POSTGRES_USER=nest
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=nest
# 5433 on the host: a native Windows PostgreSQL may already use 5432
POSTGRES_PORT=5433

# --- FastAPI (apps/api) ---
APP_ENV=development
# async SQLAlchemy URL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://nest:change-me-local-only@localhost:5433/nest
# separate database used by pytest (created by infrastructure/postgres/init)
TEST_DATABASE_URL=postgresql+asyncpg://nest:change-me-local-only@localhost:5433/nest_test
# comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3001
LOG_LEVEL=INFO

# --- Auth (ARCHITECTURE §7) ---
# signs access tokens; at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-long-random-value

# --- File storage (S3 API; docker compose `storage` = RustFS on :9000) ---
S3_ACCESS_KEY=nestlocal
S3_SECRET_KEY=change-me-local-only
S3_BUCKET=nest-files
S3_REGION=us-east-1
# how the API reaches storage
S3_ENDPOINT_URL=http://localhost:9000
# how phones reach it: presigned upload URLs are signed for this host.
# Android emulator → http://10.0.2.2:9000 ; real phone on Wi-Fi → http://<PC LAN IP>:9000
S3_PUBLIC_ENDPOINT_URL=http://10.0.2.2:9000

# --- Push (ARCHITECTURE §26) -------------------------------------------------
# "log": pushes are only logged (development, no Firebase project needed).
# "fcm": real pushes. FCM_CREDENTIALS_FILE = the Firebase service-account JSON
# (a secret; name it service-account-*.json so .gitignore keeps it out of Git).
# Run the sender next to the API:  .venv/Scripts/python -m app.cli push-worker
PUSH_PROVIDER=log
# FCM_CREDENTIALS_FILE=F:/nest-secrets/service-account-fcm.json

# --- Website intake (ARCHITECTURE §12) ---------------------------------------
# Shared secret with nest_web (its CONTACT_API_KEY), sent as X-Service-Key.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTAKE_SERVICE_KEY=change-me-local-only
