# ---------------------------------------------------------------------------
# nest-apps — root .gitignore (backend, manager web, worker mobile)
# ---------------------------------------------------------------------------

# --- Secrets / environment ---------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*.keystore
key.properties
service-account*.json
google-services.json
GoogleService-Info.plist

# --- OS / editors ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*~

# --- Python / FastAPI --------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.log

# --- Node.js / Next.js -------------------------------------------------------
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel/

# --- Flutter / Dart ----------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
**/build/
**/android/.gradle/
**/android/local.properties
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Runner.xcworkspace/xcuserdata/
*.apk
*.aab
*.ipa

# --- Local databases / runtime files ----------------------------------------
*.sqlite
*.sqlite3
*.db
pgdata/
.data/
tmp/
